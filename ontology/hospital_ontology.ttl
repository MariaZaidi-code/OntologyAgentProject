#################################################################

:DiseaseAllDifferent a owl:AllDifferent ;
    owl:members ( :Type2Diabetes :Type1Diabetes :Hypertension :CoronaryArteryDisease
                  :Asthma :Pneumonia :Migraine :Osteoarthritis :Appendicitis
                  :AlzheimerDisease :BreastCancer :COPD :Stroke :Influenza ) .

:PatientAllDifferent a owl:AllDifferent ;
    owl:members ( :p001 :p002 :p003 :p004 :p005 :p006 :p007 :p008 :p009 :p010 :p011 :p012 ) .

:MedicationAllDifferent a owl:AllDifferent ;
    owl:members ( :Metformin :Insulin :Lisinopril :Amlodipine :Aspirin :Atorvastatin
                  :Metoprolol :Albuterol :Tiotropium :Amoxicillin :Penicillin
                  :Oseltamivir :Ibuprofen :Sumatriptan :Donepezil :Tamoxifen :Warfarin ) .