@prefix : <http://example.org/hospital#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    ONTOLOGY: Hospital Management Ontology (HMO)
#    Version 1.0.0
#################################################################

<http://example.org/hospital> a owl:Ontology ;
    rdfs:label "Hospital Management Ontology"@en ;
    rdfs:comment "An OWL 2 ontology for hospital management: patients, healthcare workers, departments, diseases, symptoms, treatments, appointments, medical records and insurance."@en ;
    rdfs:seeAlso "http://example.org/hospital" ;
    owl:versionInfo "1.0.0" .

#################################################################
#    CLASSES
#################################################################

### Top level
:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human being."@en .

:Patient a owl:Class ;
    rdfs:label "Patient"@en ;
    rdfs:comment "A person who receives medical care."@en ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :HealthcareWorker .

:HealthcareWorker a owl:Class ;
    rdfs:label "Healthcare Worker"@en ;
    rdfs:comment "A person who works in a healthcare organisation."@en ;
    rdfs:subClassOf :Person .

:Doctor a owl:Class ;
    rdfs:label "Doctor"@en ;
    rdfs:comment "A physician licensed to practise medicine."@en ;
    rdfs:subClassOf :HealthcareWorker ;
    owl:disjointWith :Nurse ;
    owl:disjointWith :Pharmacist .

:GeneralPractitioner a owl:Class ;
    rdfs:label "General Practitioner"@en ;
    rdfs:subClassOf :Doctor .

:Cardiologist a owl:Class ;
    rdfs:label "Cardiologist"@en ;
    rdfs:subClassOf :Doctor .

:Neurologist a owl:Class ;
    rdfs:label "Neurologist"@en ;
    rdfs:subClassOf :Doctor .

:Pulmonologist a owl:Class ;
    rdfs:label "Pulmonologist"@en ;
    rdfs:subClassOf :Doctor .

:Oncologist a owl:Class ;
    rdfs:label "Oncologist"@en ;
    rdfs:subClassOf :Doctor .

:Pediatrician a owl:Class ;
    rdfs:label "Pediatrician"@en ;
    rdfs:subClassOf :Doctor .

:Orthopedist a owl:Class ;
    rdfs:label "Orthopedist"@en ;
    rdfs:subClassOf :Doctor .

:Endocrinologist a owl:Class ;
    rdfs:label "Endocrinologist"@en ;
    rdfs:subClassOf :Doctor .

:Surgeon a owl:Class ;
    rdfs:label "Surgeon"@en ;
    rdfs:subClassOf :Doctor .

:Nurse a owl:Class ;
    rdfs:label "Nurse"@en ;
    rdfs:subClassOf :HealthcareWorker .

:Pharmacist a owl:Class ;
    rdfs:label "Pharmacist"@en ;
    rdfs:subClassOf :HealthcareWorker .

### Organisations
:Organization a owl:Class ;
    rdfs:label "Organization"@en .

:Hospital a owl:Class ;
    rdfs:label "Hospital"@en ;
    rdfs:subClassOf :Organization .

:Department a owl:Class ;
    rdfs:label "Department"@en ;
    rdfs:comment "A clinical department inside a hospital."@en ;
    rdfs:subClassOf :Organization .

:Ward a owl:Class ;
    rdfs:label "Ward"@en ;
    rdfs:comment "A group of beds inside a department."@en ;
    rdfs:subClassOf :Organization .

:Pharmacy a owl:Class ;
    rdfs:label "Pharmacy"@en ;
    rdfs:subClassOf :Organization .

### Medical concepts
:Disease a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:comment "A disorder of structure or function."@en ;
    owl:disjointWith :Symptom ;
    owl:disjointWith :Medication ;
    owl:disjointWith :BodySystem .

:ChronicDisease a owl:Class ;
    rdfs:label "Chronic Disease"@en ;
    rdfs:subClassOf :Disease .

:AcuteDisease a owl:Class ;
    rdfs:label "Acute Disease"@en ;
    rdfs:subClassOf :Disease .

:InfectiousDisease a owl:Class ;
    rdfs:label "Infectious Disease"@en ;
    rdfs:subClassOf :Disease .

:CardiovascularDisease a owl:Class ;
    rdfs:label "Cardiovascular Disease"@en ;
    rdfs:subClassOf :Disease .

:RespiratoryDisease a owl:Class ;
    rdfs:label "Respiratory Disease"@en ;
    rdfs:subClassOf :Disease .

:NeurologicalDisease a owl:Class ;
    rdfs:label "Neurological Disease"@en ;
    rdfs:subClassOf :Disease .

:EndocrineDisease a owl:Class ;
    rdfs:label "Endocrine Disease"@en ;
    rdfs:subClassOf :Disease .

:MusculoskeletalDisease a owl:Class ;
    rdfs:label "Musculoskeletal Disease"@en ;
    rdfs:subClassOf :Disease .

:OncologicalDisease a owl:Class ;
    rdfs:label "Oncological Disease"@en ;
    rdfs:subClassOf :Disease .

:DigestiveDisease a owl:Class ;
    rdfs:label "Digestive Disease"@en ;
    rdfs:subClassOf :Disease .

:Diabetes a owl:Class ;
    rdfs:label "Diabetes"@en ;
    rdfs:comment "A group of metabolic diseases characterised by high blood glucose."@en ;
    rdfs:subClassOf :ChronicDisease ,
                     :EndocrineDisease .

:Symptom a owl:Class ;
    rdfs:label "Symptom"@en ;
    rdfs:comment "A physical or mental feature indicating a disease."@en .

:BodySystem a owl:Class ;
    rdfs:label "Body System"@en ;
    rdfs:comment "An organ system of the human body."@en .

:Treatment a owl:Class ;
    rdfs:label "Treatment"@en ;
    rdfs:comment "A method used to cure or manage a disease."@en .

:Medication a owl:Class ;
    rdfs:label "Medication"@en ;
    rdfs:subClassOf :Treatment .

:Antibiotic a owl:Class ;
    rdfs:label "Antibiotic"@en ;
    rdfs:subClassOf :Medication .

:PainReliever a owl:Class ;
    rdfs:label "Pain Reliever"@en ;
    rdfs:subClassOf :Medication .

:Therapy a owl:Class ;
    rdfs:label "Therapy"@en ;
    rdfs:subClassOf :Treatment .

:PhysicalTherapy a owl:Class ;
    rdfs:label "Physical Therapy"@en ;
    rdfs:subClassOf :Therapy .

:Surgery a owl:Class ;
    rdfs:label "Surgery"@en ;
    rdfs:subClassOf :Treatment .

### Records and administration
:Appointment a owl:Class ;
    rdfs:label "Appointment"@en ;
    rdfs:comment "A scheduled meeting between a patient and a doctor."@en .

:MedicalRecord a owl:Class ;
    rdfs:label "Medical Record"@en ;
    rdfs:comment "The documented medical history of a patient."@en .

:InsurancePlan a owl:Class ;
    rdfs:label "Insurance Plan"@en ;
    rdfs:comment "A health insurance policy that covers treatments."@en .

### Defined (inferred) classes -------------------------------------

:ChronicDiseasePatient a owl:Class ;
    rdfs:label "Chronic Disease Patient"@en ;
    rdfs:comment "Patients diagnosed with at least one chronic disease (inferred class)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :diagnosedWith ;
              owl:someValuesFrom :ChronicDisease ]
        )
    ] .

:DiabetesPatient a owl:Class ;
    rdfs:label "Diabetes Patient"@en ;
    rdfs:comment "Patients diagnosed with diabetes (inferred class)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :diagnosedWith ;
              owl:someValuesFrom :Diabetes ]
        )
    ] .

:CardiovascularPatient a owl:Class ;
    rdfs:label "Cardiovascular Patient"@en ;
    rdfs:comment "Patients diagnosed with at least one cardiovascular disease (inferred class)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :diagnosedWith ;
              owl:someValuesFrom :CardiovascularDisease ]
        )
    ] .

:PatientWithComorbidities a owl:Class ;
    rdfs:label "Patient With Comorbidities"@en ;
    rdfs:comment "Patients diagnosed with two or more distinct diseases (inferred class)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :diagnosedWith ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
              owl:onClass :Disease ]
        )
    ] .

:DepartmentHead a owl:Class ;
    rdfs:label "Department Head"@en ;
    rdfs:comment "Doctors who head a department (inferred class)."@en ;
    rdfs:subClassOf :Doctor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Doctor
            [ a owl:Restriction ;
              owl:onProperty :headOf ;
              owl:someValuesFrom :Department ]
        )
    ] .

:BusyDoctor a owl:Class ;
    rdfs:label "Busy Doctor"@en ;
    rdfs:comment "Doctors with two or more scheduled appointments (inferred class)."@en ;
    rdfs:subClassOf :Doctor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Doctor
            [ a owl:Restriction ;
              owl:onProperty :hasScheduledAppointment ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
              owl:onClass :Appointment ]
        )
    ] .

:CardiologyPatient a owl:Class ;
    rdfs:label "Cardiology Patient"@en ;
    rdfs:comment "Patients who have an appointment with a cardiologist (inferred class)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :hasAppointment ;
              owl:someValuesFrom [
                  a owl:Class ;
                  owl:intersectionOf (
                      :Appointment
                      [ a owl:Restriction ;
                        owl:onProperty :withDoctor ;
                        owl:someValuesFrom :Cardiologist ]
                  )
              ] ]
        )
    ] .

:SeniorPatient a owl:Class ;
    rdfs:label "Senior Patient"@en ;
    rdfs:comment "Patients aged 65 or older (inferred class, OWL 2 datatype restriction)."@en ;
    rdfs:subClassOf :Patient ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Patient
            [ a owl:Restriction ;
              owl:onProperty :age ;
              owl:someValuesFrom [
                  a rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:minInclusive 65 ] )
              ] ]
        )
    ] .

#################################################################
#    OBJECT PROPERTIES
#################################################################

### Patient - symptom / disease
:hasSymptom a owl:ObjectProperty ;
    rdfs:label "has symptom"@en ;
    rdfs:comment "Links a patient to a symptom they experience."@en ;
    rdfs:domain :Patient ;
    rdfs:range :Symptom .

:diagnosedWith a owl:ObjectProperty ;
    rdfs:label "diagnosed with"@en ;
    rdfs:comment "Links a patient to a disease they have been diagnosed with."@en ;
    rdfs:domain :Patient ;
    rdfs:range :Disease .

:affectsPatient a owl:ObjectProperty ;
    rdfs:label "affects patient"@en ;
    rdfs:comment "Inverse of diagnosedWith: links a disease to the patients it affects."@en ;
    owl:inverseOf :diagnosedWith .

:causes a owl:ObjectProperty ;
    rdfs:label "causes"@en ;
    rdfs:comment "Links a disease to a symptom it causes."@en ;
    rdfs:domain :Disease ;
    rdfs:range :Symptom .

:indicatedBy a owl:ObjectProperty ;
    rdfs:label "indicated by"@en ;
    rdfs:comment "Inverse of causes: links a symptom to the diseases that cause it."@en ;
    owl:inverseOf :causes .

:hasAffectedSystem a owl:ObjectProperty ;
    rdfs:label "has affected system"@en ;
    rdfs:comment "Links a disease to the body system it affects."@en ;
    rdfs:domain :Disease ;
    rdfs:range :BodySystem .

### Patient - healthcare worker
:treatedBy a owl:ObjectProperty ;
    rdfs:label "treated by"@en ;
    rdfs:comment "Links a patient to the doctor treating them."@en ;
    rdfs:domain :Patient ;
    rdfs:range :Doctor .

:treatsPatient a owl:ObjectProperty ;
    rdfs:label "treats patient"@en ;
    rdfs:comment "Inverse of treatedBy: links a doctor to the patients they treat."@en ;
    owl:inverseOf :treatedBy .

:treatsDisease a owl:ObjectProperty ;
    rdfs:label "treats disease"@en ;
    rdfs:comment "Links a healthcare worker to a disease they treat."@en ;
    rdfs:domain :HealthcareWorker ;
    rdfs:range :Disease .

### Organisational structure
:worksIn a owl:ObjectProperty ;
    rdfs:label "works in"@en ;
    rdfs:comment "Links a healthcare worker to the department they work in."@en ;
    rdfs:domain :HealthcareWorker ;
    rdfs:range :Department .

:headOf a owl:ObjectProperty ;
    rdfs:label "head of"@en ;
    rdfs:comment "Links a doctor to the department they head."@en ;
    rdfs:domain :Doctor ;
    rdfs:range :Department .

:affiliatedWith a owl:ObjectProperty ;
    rdfs:label "affiliated with"@en ;
    rdfs:comment "Links a doctor to the hospital they are affiliated with."@en ;
    rdfs:domain :Doctor ;
    rdfs:range :Hospital .

:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Transitive: links a ward to a department or a department to a hospital."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Department :Ward ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Hospital :Department ) ] ;
    a owl:TransitiveProperty .

:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Inverse of partOf."@en ;
    owl:inverseOf :partOf .

### Appointments
:forPatient a owl:ObjectProperty ;
    rdfs:label "for patient"@en ;
    rdfs:domain :Appointment ;
    rdfs:range :Patient .

:hasAppointment a owl:ObjectProperty ;
    rdfs:label "has appointment"@en ;
    rdfs:comment "Inverse of forPatient."@en ;
    owl:inverseOf :forPatient .

:withDoctor a owl:ObjectProperty ;
    rdfs:label "with doctor"@en ;
    rdfs:domain :Appointment ;
    rdfs:range :Doctor .

:hasScheduledAppointment a owl:ObjectProperty ;
    rdfs:label "has scheduled appointment"@en ;
    rdfs:comment "Inverse of withDoctor."@en ;
    owl:inverseOf :withDoctor .

### Medical records
:hasMedicalRecord a owl:ObjectProperty ;
    rdfs:label "has medical record"@en ;
    rdfs:domain :Patient ;
    rdfs:range :MedicalRecord .

:recordsDiagnosis a owl:ObjectProperty ;
    rdfs:label "records diagnosis"@en ;
    rdfs:domain :MedicalRecord ;
    rdfs:range :Disease .

:hasPrescription a owl:ObjectProperty ;
    rdfs:label "has prescription"@en ;
    rdfs:domain :MedicalRecord ;
    rdfs:range :Medication .

### Medication / treatment
:treatedWith a owl:ObjectProperty ;
    rdfs:label "treated with"@en ;
    rdfs:comment "Links a disease to the treatment used against it."@en ;
    rdfs:domain :Disease ;
    rdfs:range :Treatment .

:prescribedFor a owl:ObjectProperty ;
    rdfs:label "prescribed for"@en ;
    rdfs:comment "Links a medication to the patient it was prescribed to."@en ;
    rdfs:domain :Medication ;
    rdfs:range :Patient .

:prescribedBy a owl:ObjectProperty ;
    rdfs:label "prescribed by"@en ;
    rdfs:comment "Links a medication to the doctor who prescribed it."@en ;
    rdfs:domain :Medication ;
    rdfs:range :Doctor .

:interactsWith a owl:ObjectProperty ;
    rdfs:label "interacts with"@en ;
    rdfs:comment "Symmetric and irreflexive: links two medications that interact."@en ;
    rdfs:domain :Medication ;
    rdfs:range :Medication ;
    a owl:SymmetricProperty , owl:IrreflexiveProperty .

:allergicTo a owl:ObjectProperty ;
    rdfs:label "allergic to"@en ;
    rdfs:comment "Links a patient to a medication they are allergic to."@en ;
    rdfs:domain :Patient ;
    rdfs:range :Medication .

### Insurance
:hasInsurance a owl:ObjectProperty ;
    rdfs:label "has insurance"@en ;
    rdfs:domain :Patient ;
    rdfs:range :InsurancePlan .

:coversDisease a owl:ObjectProperty ;
    rdfs:label "covers disease"@en ;
    rdfs:domain :InsurancePlan ;
    rdfs:range :Disease .

#################################################################
#    DATA PROPERTIES
#################################################################

:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:range xsd:string .

:patientId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "patient ID"@en ;
    rdfs:domain :Patient ;
    rdfs:range xsd:string .

:doctorId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "doctor ID"@en ;
    rdfs:domain :Doctor ;
    rdfs:range xsd:string .

:employeeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee ID"@en ;
    rdfs:domain :HealthcareWorker ;
    rdfs:range xsd:string .

:licenseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "license number"@en ;
    rdfs:domain :Doctor ;
    rdfs:range xsd:string .

:specialty a owl:DatatypeProperty ;
    rdfs:label "specialty"@en ;
    rdfs:domain :Doctor ;
    rdfs:range xsd:string .

:age a owl:DatatypeProperty ;
    rdfs:label "age"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:integer .

:birthDate a owl:DatatypeProperty ;
    rdfs:label "birth date"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:dateTime .

:gender a owl:DatatypeProperty ;
    rdfs:label "gender"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:bloodGroup a owl:DatatypeProperty ;
    rdfs:label "blood group"@en ;
    rdfs:domain :Patient ;
    rdfs:range xsd:string .

:phone a owl:DatatypeProperty ;
    rdfs:label "phone"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:label "email"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:comment "Symptom severity on a scale from 1 (mild) to 10 (extreme)."@en ;
    rdfs:domain :Symptom ;
    rdfs:range xsd:integer .

:roomNumber a owl:DatatypeProperty ;
    rdfs:label "room number"@en ;
    rdfs:domain :Ward ;
    rdfs:range xsd:string .

:appointmentDate a owl:DatatypeProperty ;
    rdfs:label "appointment date"@en ;
    rdfs:domain :Appointment ;
    rdfs:range xsd:dateTime .

:appointmentTime a owl:DatatypeProperty ;
    rdfs:label "appointment time"@en ;
    rdfs:domain :Appointment ;
    rdfs:range xsd:string .

:reason a owl:DatatypeProperty ;
    rdfs:label "reason"@en ;
    rdfs:domain :Appointment ;
    rdfs:range xsd:string .

:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:domain :Appointment ;
    rdfs:range xsd:string .

:cost a owl:DatatypeProperty ;
    rdfs:label "cost"@en ;
    rdfs:comment "Cost in US dollars."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Appointment :Medication ) ] ;
    rdfs:range xsd:decimal .

:dosage a owl:DatatypeProperty ;
    rdfs:label "dosage"@en ;
    rdfs:domain :Medication ;
    rdfs:range xsd:string .

:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency"@en ;
    rdfs:domain :Medication ;
    rdfs:range xsd:string .

:recordDate a owl:DatatypeProperty ;
    rdfs:label "record date"@en ;
    rdfs:domain :MedicalRecord ;
    rdfs:range xsd:dateTime .

:policyNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "policy number"@en ;
    rdfs:domain :InsurancePlan ;
    rdfs:range xsd:string .

:coveragePercentage a owl:DatatypeProperty ;
    rdfs:label "coverage percentage"@en ;
    rdfs:domain :InsurancePlan ;
    rdfs:range xsd:decimal .

:monthlyPremium a owl:DatatypeProperty ;
    rdfs:label "monthly premium"@en ;
    rdfs:domain :InsurancePlan ;
    rdfs:range xsd:decimal .

:city a owl:DatatypeProperty ;
    rdfs:label "city"@en ;
    rdfs:domain :Hospital ;
    rdfs:range xsd:string .

:address a owl:DatatypeProperty ;
    rdfs:label "address"@en ;
    rdfs:domain :Hospital ;
    rdfs:range xsd:string .

#################################################################
#    INDIVIDUALS - Organisations
#################################################################

:hosp_stmary a owl:NamedIndividual , :Hospital ;
    rdfs:label "St. Mary's Hospital"@en ;
    :name "St. Mary's Hospital" ;
    :city "Springfield" ;
    :address "123 Health Avenue, Springfield" .

:hosp_city a owl:NamedIndividual , :Hospital ;
    rdfs:label "City General Hospital"@en ;
    :name "City General Hospital" ;
    :city "Riverton" ;
    :address "88 Riverside Drive, Riverton" .

### Departments
:dept_gp a owl:NamedIndividual , :Department ;
    rdfs:label "Internal Medicine"@en ;
    :name "Internal Medicine" ;
    :partOf :hosp_stmary .

:dept_cardio a owl:NamedIndividual , :Department ;
    rdfs:label "Cardiology"@en ;
    :name "Cardiology" ;
    :partOf :hosp_stmary .

:dept_neuro a owl:NamedIndividual , :Department ;
    rdfs:label "Neurology"@en ;
    :name "Neurology" ;
    :partOf :hosp_stmary .

:dept_pulm a owl:NamedIndividual , :Department ;
    rdfs:label "Pulmonology"@en ;
    :name "Pulmonology" ;
    :partOf :hosp_stmary .

:dept_surgery a owl:NamedIndividual , :Department ;
    rdfs:label "Surgery"@en ;
    :name "Surgery" ;
    :partOf :hosp_stmary .

:dept_onco a owl:NamedIndividual , :Department ;
    rdfs:label "Oncology"@en ;
    :name "Oncology" ;
    :partOf :hosp_stmary .

:dept_peds a owl:NamedIndividual , :Department ;
    rdfs:label "Pediatrics"@en ;
    :name "Pediatrics" ;
    :partOf :hosp_stmary .

:dept_ortho a owl:NamedIndividual , :Department ;
    rdfs:label "Orthopedics"@en ;
    :name "Orthopedics" ;
    :partOf :hosp_stmary .

:dept_endo a owl:NamedIndividual , :Department ;
    rdfs:label "Endocrinology"@en ;
    :name "Endocrinology" ;
    :partOf :hosp_stmary .

:dept_emerg a owl:NamedIndividual , :Department ;
    rdfs:label "Emergency"@en ;
    :name "Emergency" ;
    :partOf :hosp_stmary .

:dept_cardio_city a owl:NamedIndividual , :Department ;
    rdfs:label "Cardiology (City General)"@en ;
    :name "Cardiology" ;
    :partOf :hosp_city .

### Wards
:ward_cardio_icu a owl:NamedIndividual , :Ward ;
    rdfs:label "Cardiac ICU"@en ;
    :name "Cardiac ICU" ;
    :roomNumber "ICU-3" ;
    :partOf :dept_cardio .

:ward_neuro a owl:NamedIndividual , :Ward ;
    rdfs:label "Neurology Ward"@en ;
    :name "Neurology Ward" ;
    :roomNumber "NW-2" ;
    :partOf :dept_neuro .

:ward_surgery a owl:NamedIndividual , :Ward ;
    rdfs:label "Surgical Ward"@en ;
    :name "Surgical Ward" ;
    :roomNumber "SW-1" ;
    :partOf :dept_surgery .

:ward_peds a owl:NamedIndividual , :Ward ;
    rdfs:label "Pediatric Ward"@en ;
    :name "Pediatric Ward" ;
    :roomNumber "PW-4" ;
    :partOf :dept_peds .

:pharmacy_stmary a owl:NamedIndividual , :Pharmacy ;
    rdfs:label "St. Mary's Pharmacy"@en ;
    :name "St. Mary's Pharmacy" ;
    :partOf :hosp_stmary .

#################################################################
#    INDIVIDUALS - Healthcare workers
#################################################################

:d001 a owl:NamedIndividual , :GeneralPractitioner ;
    rdfs:label "Dr. Alice Chen"@en ;
    :name "Alice Chen" ;
    :doctorId "MD-1001" ;
    :licenseNumber "MD-1001" ;
    :specialty "Family Medicine" ;
